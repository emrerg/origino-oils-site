{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/journey/**",
              "ui_kits/unpacking/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Neue Haas Grotesk Display Pro|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Neue Haas Grotesk Display Pro, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component3'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|name|state|text1|text2|text3|text4|icon1|icon2|icon3|key|ref|className|style|children)$/]",
        "message": "<Component3> doesn't accept that prop. Declared props: className, style, name, state, text1, text2, text3, text4, icon1, icon2, icon3."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component3'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:pressed|packed|free acidity|polyphenols|picked)$/]",
        "message": "<Component3> name must be one of 'pressed' | 'packed' | 'free acidity' | 'polyphenols' | 'picked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Component3'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:close|open)$/]",
        "message": "<Component3> state must be one of 'close' | 'open'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginoJourney'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<OriginoJourney> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginoJourney2'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<OriginoJourney2> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginoJourney3'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<OriginoJourney3> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginoJourney4'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<OriginoJourney4> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginoJourney5'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<OriginoJourney5> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginoJourney6'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<OriginoJourney6> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginoJourney7'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<OriginoJourney7> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OriginoJourney8'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<OriginoJourney8> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rectangle613'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|key|ref|className|style|children)$/]",
        "message": "<Rectangle613> doesn't accept that prop. Declared props: className, style, property1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rectangle613'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|variant2)$/]",
        "message": "<Rectangle613> property1 must be one of 'default' | 'variant2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RemixIconsLineSystemArrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<RemixIconsLineSystemArrow> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RemixIconsLineSystemArrow2'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<RemixIconsLineSystemArrow2> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RemixIconsLineSystemArrow3'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<RemixIconsLineSystemArrow3> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RemixIconsLineSystemClose'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<RemixIconsLineSystemClose> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Storage'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Storage> doesn't accept that prop. Declared props: className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
